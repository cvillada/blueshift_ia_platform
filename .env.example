# BlueShift IA Platform — variaveis de ambiente (instalacao)
# Copie este arquivo para .env e ajuste antes de rodar ./install.sh
# (ou exporte as variaveis no shell para rodar sem Docker: blueshift portal)

# Chave de ativacao emitida pela BlueShift mediante cadastro da empresa
# (razao social, CNPJ, contato) — solicite no canal oficial da BlueShift.
# VAZIA = plataforma nao ativada. NUNCA preencha BS-DEV-* em instalacao de
# cliente: chaves BS-DEV-* so sao aceitas em dev local (BLUESHIFT_DEV=1).
BLUESHIFT_LICENSE=

# Porta de acesso ao Portal do Cliente no host (sem Docker)
PORTAL_PORT=8080

# Update via Git: diretorio do clone do repositorio no servidor.
# O portal le a versao (git describe) e aplica a tag nova com
# update.sh (git fetch + checkout + docker compose up -d --build).
# Em Docker, o compose monta o repo no container (default: o proprio
# diretorio do compose). Em producao, clone em /opt/blueshift/repo.
BLUESHIFT_REPO_DIR=/opt/blueshift/repo

# 1 = ambiente de dev/demo (update em dry-run, chaves BS-DEV- aceitas)
# Em producao, defina 0
# Modo DEV (1 = dev: atualizacao simulada/dry-run + fallback tags locais; 0 = producao:
# a tela Atualizacoes aplica de verdade). CLIENTE/PRODUCAO = 0.
BLUESHIFT_DEV=0

# Areas: SEED INICIAL apenas — depois a tela Cadastros -> Areas (banco)
# domina. O env so popula a tabela no primeiro boot.
BLUESHIFT_AREAS=vendas,suporte,financeiro,rh,operacoes

# 1 = cria dados de exemplo XPTO (dev); 0 = banco limpo — o cliente final
# cadastra a propria empresa na primeira entrada (setup inicial)
BLUESHIFT_SEED_DEMO=1

# Modelo de ROTEAMENTO dos conectores: a IA que decide qual conector usar
# em cada pergunta. Aceita o ID ou o NOME do modelo (o nome e o que aparece
# na tela Modelos IA — ex: hermes-3-llama-3.1-8b). Vazio = usa o modelo
# principal de cada agente. Recomendado: um modelo local rapido
# (hermes-3-llama-3.1-8b) — custo ~0.
BLUESHIFT_ROUTER_MODEL=2

# Sessao do portal: chave FIXA entre deploys (se muda a cada rebuild,
# todos os logins caem). Trocar em producao e manter estavel.
BLUESHIFT_PORTAL_SECRET=bs-portal-secret-troque-em-producao

# License server: mock local em dev; em producao aponte para o License
# Server da BlueShift (backend da pagina de solicitacao de chave — o mesmo
# que emitiu a BLUESHIFT_LICENSE). Sem a URL real, o container valida
# contra o mock local (que so conhece chaves de teste) e a chave real
# aparece como invalida.
BLUESHIFT_LICENSE_URL=http://localhost:9000/v1/validate
BLUESHIFT_LICENSE_PORT=9000

# Gateway OpenAI-compativel (chats externos: Open WebUI, LibreChat, apps).
# Porta publicada do gateway — o chat externo usa http://<servidor>:<porta>/v1
GATEWAY_PORT=9003
# URL publica do gateway (opcional). Se definida, a tela Gateway mostra esta
# URL como endpoint (ex: http://192.168.0.10:9003/v1). Sem ela, usa o host
# da requisicao. Dica Docker (chat externo em container na mesma maquina):
# http://host.docker.internal:9003/v1
# GATEWAY_PUBLIC_URL=http://192.168.0.10:9003/v1
