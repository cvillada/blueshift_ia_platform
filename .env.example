# BlueShift IA Platform — variaveis de ambiente do installer
# Copie este arquivo para .env e ajuste antes de rodar ./install.sh

# Chave de licenca (em dev, qualquer chave com prefixo BS-DEV- e valida)
BLUESHIFT_LICENSE=BS-DEV-sua-empresa-001

# Porta de acesso ao Portal do Cliente no host
PORTAL_PORT=8080

# Update Channel: em dev aponta para o mock interno. Em prod, aponte para
# o backend real da BlueShift (https://update.blueshift.app/v1/channel)
BLUESHIFT_UPDATE_URL=http://localhost:9001/v1/channel

# 1 = ambiente de dev/demo (update em dry-run, chaves BS-DEV- aceitas)
# Em producao, defina 0
BLUESHIFT_DEV=1
